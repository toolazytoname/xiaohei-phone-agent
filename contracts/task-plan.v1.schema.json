{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toolazytoname/xiaohei-phone-agent/contracts/task-plan.v1.schema.json",
  "title": "Xiaohei Task Plan v1",
  "description": "A bounded dry-run DAG proposal. Validation grants no model, tool, Android, or execution authority.",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "request_id",
    "dry_run",
    "step_budget",
    "timeout_ms",
    "created_at",
    "public_log_safe",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "dry_run": {"const": true},
    "step_budget": {"type": "integer", "minimum": 1, "maximum": 8},
    "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 60000},
    "created_at": {"type": "string", "format": "date-time"},
    "public_log_safe": {"const": false},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tool",
          "tool_version",
          "risk",
          "depends_on",
          "arguments",
          "idempotency_key"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
          "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
          "tool_version": {"const": 1},
          "risk": {"enum": ["observe", "low", "reversible", "high"]},
          "depends_on": {
            "type": "array",
            "maxItems": 7,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"}
          },
          "arguments": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
            "additionalProperties": {"type": "string", "maxLength": 1024}
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
