{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toolazytoname/xiaohei-phone-agent/contracts/tool-output-activity.v1.schema.json",
  "title": "Xiaohei Activity Tool Output v1",
  "type": "object",
  "required": ["opened", "target_package", "public_log_safe"],
  "properties": {
    "opened": {"type": "boolean"},
    "target_package": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,254}$"},
    "public_log_safe": {"const": false}
  },
  "additionalProperties": false
}
