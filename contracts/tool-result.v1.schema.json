{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toolazytoname/xiaohei-phone-agent/contracts/tool-result.v1.schema.json",
  "title": "Xiaohei Tool Result v1",
  "description": "A bounded, private execution outcome. It contains no raw exception text and grants no authority.",
  "type": "object",
  "required": [
    "schema_version", "task_id", "call_id", "tool", "status", "error_code",
    "output", "started_at_elapsed_ms", "finished_at_elapsed_ms", "duration_ms",
    "adapter_calls", "public_log_safe"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "call_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
    "status": {"enum": ["success", "denied", "cancelled", "timeout", "failed", "rollback_required"]},
    "error_code": {"enum": [
      "none", "authorization_denied", "authorization_replay", "authorization_expired",
      "scope_changed", "adapter_missing", "invalid_output", "user_cancelled", "global_stop",
      "client_disconnected", "caller_interrupted", "deadline_exceeded", "network_unavailable",
      "process_exit_nonzero", "adapter_failure", "rollback_required"
    ]},
    "output": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {"type": "string", "maxLength": 1024}
    },
    "started_at_elapsed_ms": {"type": "integer", "minimum": 0},
    "finished_at_elapsed_ms": {"type": "integer", "minimum": 0},
    "duration_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
    "adapter_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "public_log_safe": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "success"}}}, "then": {"properties": {"error_code": {"const": "none"}, "adapter_calls": {"const": 1}}}},
    {"if": {"properties": {"status": {"const": "denied"}}}, "then": {"properties": {"error_code": {"enum": ["authorization_denied", "authorization_replay", "authorization_expired", "scope_changed"]}, "adapter_calls": {"const": 0}}}},
    {"if": {"properties": {"status": {"const": "cancelled"}}}, "then": {"properties": {"error_code": {"enum": ["user_cancelled", "global_stop", "client_disconnected", "caller_interrupted"]}}}},
    {"if": {"properties": {"status": {"const": "timeout"}}}, "then": {"properties": {"error_code": {"const": "deadline_exceeded"}, "adapter_calls": {"const": 1}}}},
    {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"properties": {"error_code": {"enum": ["adapter_missing", "invalid_output", "network_unavailable", "process_exit_nonzero", "adapter_failure"]}}}},
    {"if": {"properties": {"status": {"const": "rollback_required"}}}, "then": {"properties": {"error_code": {"const": "rollback_required"}, "adapter_calls": {"const": 1}}}}
  ],
  "additionalProperties": false
}
