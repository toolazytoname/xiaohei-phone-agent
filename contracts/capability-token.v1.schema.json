{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toolazytoname/xiaohei-phone-agent/contracts/capability-token.v1.schema.json",
  "title": "Xiaohei Capability Token v1",
  "description": "Inspectable metadata for one in-memory gateway capability. JSON alone is never accepted as authority.",
  "type": "object",
  "required": [
    "schema_version", "token_id", "confirmation_id", "task_id", "request_id",
    "plan_id", "call_id", "tool", "tool_version", "risk", "audience",
    "call_digest", "call_timeout_ms", "issued_at_elapsed_ms", "expires_at_elapsed_ms", "ttl_ms",
    "single_use", "persistence", "public_log_safe"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "token_id": {"type": "string", "pattern": "^cap-[a-f0-9]{32}$"},
    "confirmation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "call_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
    "tool_version": {"const": 1},
    "risk": {"enum": ["observe", "low", "reversible", "high"]},
    "audience": {"enum": ["android_gateway", "opencode_gateway", "root_broker"]},
    "call_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "call_timeout_ms": {"type": "integer", "minimum": 100, "maximum": 60000},
    "issued_at_elapsed_ms": {"type": "integer", "minimum": 0},
    "expires_at_elapsed_ms": {"type": "integer", "minimum": 1},
    "ttl_ms": {"type": "integer", "minimum": 1000, "maximum": 30000},
    "single_use": {"const": true},
    "persistence": {"const": "memory_only"},
    "public_log_safe": {"const": false}
  },
  "additionalProperties": false
}
