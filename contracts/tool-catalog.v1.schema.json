{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toolazytoname/xiaohei-phone-agent/contracts/tool-catalog.v1.schema.json",
  "title": "Xiaohei Tool Catalog v1",
  "description": "Reviewed tool metadata. A catalog entry is not execution authority and rollback is only a declaration.",
  "type": "object",
  "required": ["schema_version", "catalog_id", "tools"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"const": "xiaohei.tool-catalog.v1"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "name", "version", "risk", "input_schema", "output_schema",
          "rollback", "audience", "timeout_ms"
        ],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
          "version": {"const": 1},
          "risk": {"enum": ["observe", "low", "reversible", "high"]},
          "input_schema": {"type": "string", "pattern": "^xiaohei\\.tool\\.input\\.[a-z0-9_.-]{1,96}\\.v1$"},
          "output_schema": {"type": "string", "pattern": "^xiaohei\\.tool\\.output\\.[a-z0-9_.-]{1,96}\\.v1$"},
          "rollback": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {"enum": ["none", "restore_snapshot", "reverse_tool", "manual"]},
              "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"}
            },
            "additionalProperties": false
          },
          "audience": {"enum": ["android_gateway", "opencode_gateway", "root_broker"]},
          "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 60000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
